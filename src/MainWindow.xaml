  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#34433F"/><Setter Property="Padding" Value="10,7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#B6C1BD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#F5F7F2"/><Setter Property="SelectionBrush" Value="#F5B18F"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" CornerRadius="2" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#F6E8DD"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#D84C20"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#34433F"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="#F5F7F2"/><Setter Property="BorderBrush" Value="#B6C1BD"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Face" Background="#F5F7F2" BorderBrush="#B6C1BD" BorderThickness="1" CornerRadius="3"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#6C7C74" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#C6714D"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#D84C20"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,7,30,7" VerticalAlignment="Center" IsHitTestVisible="False"/>
   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#F5F7F2" BorderBrush="#AEBBB5" BorderThickness="1" CornerRadius="3" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#D84C20"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="1,5"><Grid><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" Margin="0,0,20,0"/><Path x:Name="Chevron" Data="M 0 0 L 4 4 L 8 0" Stroke="#6C7C74" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#D84C20"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="Body" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Segment" TargetType="RadioButton"><Setter Property="Foreground" Value="#4B6454"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Key" Background="#D0DAD2" BorderBrush="#ADBDB0" BorderThickness="1" Padding="4,10" Margin="0,0,2,0" CornerRadius="2"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Key" Property="Background" Value="#314D3B"/><Setter TargetName="Key" Property="BorderBrush" Value="#314D3B"/><Setter Property="Foreground" Value="#F1F4ED"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Key" Property="BorderBrush" Value="#D84C20"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Key" Property="BorderBrush" Value="#D84C20"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="17" Height="17" CornerRadius="2" Background="#F5F7F2" BorderBrush="#A6B3AC" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 3 7 L 6 10 L 12 3" Stroke="White" StrokeThickness="1.8" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#D84C20"/><Setter TargetName="Box" Property="BorderBrush" Value="#D84C20"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#24322F"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListViewItem"><Setter Property="Padding" Value="4,11"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E7ECE8"/><Setter Property="ToolTip" Value="{Binding Path}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#F6E8DD"/></Trigger></Style.Triggers></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#DCE1DF"/><Setter Property="Foreground" Value="#6B7D72"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="10,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#6B7D72"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Badge" TargetType="Border"><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="8,4"/><Setter Property="Background" Value="#E7ECE8"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="处理中"><Setter Property="Background" Value="#F8E4D8"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="已压缩"><Setter Property="Background" Value="#E7F4EE"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="已解压"><Setter Property="Background" Value="#E7F4EE"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="失败"><Setter Property="Background" Value="#FCEBE9"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="已取消"><Setter Property="Background" Value="#FFF3DC"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="StatusText" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#6B7D72"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="处理中"><Setter Property="Foreground" Value="#D84C20"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="已压缩"><Setter Property="Foreground" Value="#24735A"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="已解压"><Setter Property="Foreground" Value="#24735A"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="失败"><Setter Property="Foreground" Value="#B1443D"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="已取消"><Setter Property="Foreground" Value="#916A21"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid x:Name="Workspace" Margin="28,22,28,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#263D32" Padding="13,7" CornerRadius="2"><TextBlock Text="UPX" FontFamily="Bahnschrift" FontSize="33" FontWeight="Bold" Foreground="#F1F4ED"/></Border><StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="DROP" FontFamily="Bahnschrift" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="可执行文件压缩器" FontSize="11" Foreground="#637A6A" Margin="0,3,0,0"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="7" Height="7" x:Name="RunIndicator" Fill="#7C9786" Margin="0,0,8,0"/><TextBlock x:Name="EngineLabel" Text="UPX 5.2.1 · 已就绪" FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="12" Foreground="#405C49"/></StackPanel><TextBlock Text="LOCAL FILE PROCESSOR" FontFamily="Bahnschrift" Foreground="#7B9081" FontSize="10" Margin="0,8,0,0" HorizontalAlignment="Right"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="266"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="DropSurface" Background="#263D32" BorderBrush="#263D32" BorderThickness="1" CornerRadius="3"><Grid Margin="22,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="DropTitle" Text="投放文件" FontSize="19" FontWeight="SemiBold" Foreground="#F1F4ED"/><TextBlock Text="拖入 EXE、DLL 或文件夹" Foreground="#A6BBAC" FontSize="12" Margin="0,9,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><Button x:Name="AddButton" Content="添加文件" Foreground="White" Background="#D84C20" BorderBrush="#D84C20" Padding="20,8" ToolTip="Ctrl+O"/><Button x:Name="FolderButton" Content="选择文件夹" Foreground="#C9D7CD" Style="{StaticResource QuietButton}" Margin="0,3,0,0"/></StackPanel></Grid></Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
     <TextBlock Text="总计" Foreground="#6E8274" FontSize="12"/><TextBlock x:Name="TotalSize" Text="0 B" FontWeight="SemiBold" Margin="8,0,26,0" FontSize="12"/>
     <TextBlock x:Name="SavedLabel" Text="净节省" Foreground="#6E8274" FontSize="12"/><TextBlock x:Name="SavedSize" Text="0 B" FontWeight="SemiBold" Margin="8,0,26,0" FontSize="12"/>
     <TextBlock Text="已完成" Foreground="#6E8274" FontSize="12"/><TextBlock x:Name="DoneCount" Text="0" FontWeight="SemiBold" Margin="8,0,0,0" FontSize="12"/>
    </StackPanel>
    <Border Grid.Row="2" Background="#F5F7F2" CornerRadius="3" BorderBrush="#B8C5BD" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="16,12,12,10"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="文件队列" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="QueueCount" Text="0" Foreground="#708277" Margin="8,1,0,0"/></StackPanel><Button x:Name="ExportButton" Content="导出 CSV" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" ToolTip="导出整个队列，包括筛选隐藏的文件"/></Grid>
     <Grid Grid.Row="1" Margin="14,0,14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="SearchBox" ToolTip="搜索文件名或路径 · Ctrl+F"/><TextBlock Text="搜索文件名或路径" Foreground="#7D8D82" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="StatusFilter" Grid.Column="2" SelectedIndex="0"><ComboBoxItem Content="全部状态"/><ComboBoxItem Content="等待 / 处理中"/><ComboBoxItem Content="已完成"/><ComboBoxItem Content="失败 / 已取消"/></ComboBox></Grid>
     <ListView Foreground="#24322F" x:Name="Files" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><ListView.View><GridView>
      <GridViewColumn Header="文件" Width="270"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Margin="4,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Folder}" FontSize="10" Foreground="#7D8D82" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn Header="状态" Width="86"><GridViewColumn.CellTemplate><DataTemplate><Border Style="{StaticResource Badge}" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/></Border></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn Header="原大小" DisplayMemberBinding="{Binding Before}" Width="86"/><GridViewColumn Header="处理后" DisplayMemberBinding="{Binding After}" Width="86"/><GridViewColumn Header="变化" Width="76"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Saving}" Foreground="#D84C20" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     </GridView></ListView.View></ListView>
     <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=Files}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Path Data="M 2 1 L 22 1 L 30 9 L 30 37 L 2 37 Z M 22 1 L 22 9 L 30 9 M 10 21 L 22 21 M 16 15 L 16 27" Stroke="#A2B2A8" StrokeThickness="1.7" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="还没有文件" Foreground="#667D6D" FontSize="14" Margin="0,14,0,0" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="拖入 EXE、DLL 或整个文件夹" FontSize="11" Foreground="#7E9284" Margin="0,7,0,0"/></StackPanel>
     <Border Grid.Row="3" BorderBrush="#D3DDD5" BorderThickness="0,1,0,0" Padding="10,6"><Grid><StackPanel Orientation="Horizontal"><Button x:Name="RetryButton" Content="重试未完成" Style="{StaticResource QuietButton}"/><Button x:Name="RemoveButton" Content="移除选中" Style="{StaticResource QuietButton}" ToolTip="仅移出队列，不删除文件 · Delete"/><Button x:Name="ClearButton" Content="清理已完成" Style="{StaticResource QuietButton}"/></StackPanel><TextBlock x:Name="VisibleCount" Text="显示 0 / 0" FontSize="11" Foreground="#7D8D82" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/></Grid></Border>
    </Grid></Border>
    <Expander x:Name="DetailsExpander" Grid.Row="3" Header="文件详情与运行日志" Foreground="#647B6B" FontSize="11" Margin="0,12,0,0"><Grid Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button x:Name="RevealButton" Content="在文件夹中显示" HorizontalAlignment="Right" Style="{StaticResource QuietButton}"/><TextBox x:Name="Details" Grid.Row="1" Height="72" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#CBD6CD" Foreground="#516B5B" Text="选择文件，查看完整路径和处理日志。"/></Grid></Expander>
    <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="Summary" Text="准备就绪" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="ProgressText" Text="等待添加文件" Foreground="#6E8274" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="StopButton" Content="停止" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="StartButton" Content="开始压缩" Background="#D84C20" BorderBrush="#D84C20" Foreground="White" Padding="23,11"/></StackPanel><ProgressBar x:Name="QueueProgress" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="0" Height="3" Margin="0,12,0,0" BorderThickness="0" Background="#B8C7BC" Foreground="#D84C20"/>
    </Grid>
   </Grid>
   <Border Grid.Column="2" Background="Transparent" BorderBrush="#AEBBB5" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,10,0,16">
    <TextBlock Text="控制面板" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,20"/>
    <TextBlock Text="处理方式" Style="{StaticResource Label}"/><UniformGrid x:Name="ModeSelector" Columns="2" Margin="0,0,0,0"><RadioButton x:Name="PackMode" GroupName="Operation" Content="压缩" Style="{StaticResource Segment}"/><RadioButton x:Name="UnpackMode" GroupName="Operation" Content="解压" Style="{StaticResource Segment}"/></UniformGrid><ComboBox x:Name="Mode" Visibility="Collapsed" SelectedIndex="0"><ComboBoxItem Content="压缩文件"/><ComboBoxItem Content="解压还原"/></ComboBox>
    <TextBlock Text="压缩强度" Style="{StaticResource Label}" Margin="0,18,0,8"/><UniformGrid x:Name="PresetSelector" Columns="3"><RadioButton x:Name="FastPreset" GroupName="Level" Content="快速" Style="{StaticResource Segment}"/><RadioButton x:Name="BalancedPreset" GroupName="Level" Content="均衡" Style="{StaticResource Segment}"/><RadioButton x:Name="BestPreset" GroupName="Level" Content="极致" Style="{StaticResource Segment}"/></UniformGrid><ComboBox x:Name="Preset" Visibility="Collapsed" SelectedIndex="0"><ComboBoxItem Content="均衡 · 推荐"/><ComboBoxItem Content="快速 · 优先速度"/><ComboBoxItem Content="极致 · 优先体积"/></ComboBox>
    <TextBlock x:Name="ModeHint" Text="压缩后校验通过，再替换原文件。" Foreground="#6E8274" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,18"/>
    <CheckBox x:Name="AutoStart" Content="添加后自动开始" IsChecked="True"/><StackPanel x:Name="AdvancedOptions"><CheckBox x:Name="Backup" Content="保留原文件备份" IsChecked="False" ToolTip="在原文件旁保存独立命名的 .bak，不覆盖已有备份。"/>
     <Border Height="1" Background="#D3DDD5" Margin="0,18"/>
     <Expander x:Name="AdvancedExpander" Header="高级压缩选项"><StackPanel x:Name="CompressionOptions" Margin="0,12,0,0"><CheckBox x:Name="AllMethods" Content="尝试全部方法" ToolTip="--all-methods；耗时较长。"/><CheckBox x:Name="CompressExports" Content="压缩导出区段" IsChecked="True"/><CheckBox x:Name="StripRelocs" Content="移除重定位数据" ToolTip="仅适用于未启用 ASLR 的兼容 EXE，默认保留。"/><CheckBox x:Name="Force" Content="强制压缩可疑文件" ToolTip="可能影响程序运行；签名文件仍会跳过。"/><TextBlock Text="附加数据" Style="{StaticResource Label}" Margin="0,14,0,8"/><ComboBox x:Name="Overlay" SelectedIndex="0"><ComboBoxItem Content="保留附加数据"/><ComboBoxItem Content="丢弃（不可还原）"/><ComboBoxItem Content="含附加数据时跳过"/></ComboBox><TextBlock Text="图标处理" Style="{StaticResource Label}" Margin="0,14,0,8"/><ComboBox x:Name="Icons" SelectedIndex="2"><ComboBoxItem Content="不压缩图标"/><ComboBoxItem Content="保留第一个图标"/><ComboBoxItem Content="保留第一个图标目录"/><ComboBoxItem Content="压缩全部图标"/></ComboBox></StackPanel></Expander>
    </StackPanel>
    <Border Height="1" Background="#D3DDD5" Margin="0,20"/>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="体积对比" Style="{StaticResource Label}"/><Grid Margin="0,1,0,8"><TextBlock Text="输入" FontSize="10" Foreground="#657C6B"/><TextBlock x:Name="MeterBefore" Text="0 B" HorizontalAlignment="Right" FontFamily="Bahnschrift" FontSize="12"/></Grid><UniformGrid x:Name="InputMeter" Columns="24" Height="14"/><Grid Margin="0,10,0,8"><TextBlock Text="输出" FontSize="10" Foreground="#657C6B"/><TextBlock x:Name="MeterAfter" Text="—" HorizontalAlignment="Right" FontFamily="Bahnschrift" FontSize="12"/></Grid><UniformGrid x:Name="OutputMeter" Columns="24" Height="14"/><TextBlock Text="随已完成文件更新" Foreground="#7E9284" FontSize="10" Margin="0,8,0,0"/></StackPanel>
    <Expander Header="引擎管理"><StackPanel Margin="0,10,0,0"><TextBlock Text="官方 UPX 5.2.1" FontWeight="SemiBold"/><TextBlock Text="文件在本机处理" Foreground="#6E8274" FontSize="11" Margin="0,7,0,10" TextWrapping="Wrap"/><Button x:Name="DownloadButton" Content="恢复内嵌引擎" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><Button x:Name="EngineButton" Content="选择其他 UPX" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/></StackPanel></Expander>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="ProjectButton" Content="GitHub" Style="{StaticResource QuietButton}"/><Button x:Name="LicenseButton" Content="关于与许可" Style="{StaticResource QuietButton}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="AutoUpdate" Content="自动更新" IsChecked="True" FontSize="11" Margin="0,0,12,0"/><Button x:Name="UpdateButton" Content="检查更新" Style="{StaticResource QuietButton}"/></StackPanel><TextBlock x:Name="UpdateStatus" Grid.Row="1" Grid.ColumnSpan="2" Text="更新校验完成后，将在退出时安装。" Foreground="#6E8274" FontSize="10" Margin="8,3,0,0" TextWrapping="Wrap"/></Grid>
 </Grid>
</Window>
