<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UPX Drop" Width="1140" Height="820" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#F6F7F9" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#202938" AllowDrop="True" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#257A68"/>
  <Style TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#384455"/><Setter Property="BorderBrush" Value="#DDE3E9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#257A68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,4"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#6A7585"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE3E9"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,0,7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="White" BorderBrush="#BAC4CF" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 3 7 L 6 10 L 12 3" Stroke="White" StrokeThickness="1.7" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#257A68"/><Setter TargetName="Box" Property="BorderBrush" Value="#257A68"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#202938"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListViewItem"><Setter Property="Padding" Value="8,12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#F0F2F5"/></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#FAFBFC"/><Setter Property="Foreground" Value="#7B8695"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#86919E"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 </Window.Resources>
 <Grid Margin="26,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="42" Height="42" Background="#203F39" CornerRadius="11"><TextBlock Text="↓" FontSize="27" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="UPX Drop" FontWeight="SemiBold" FontSize="23"/><TextBlock Text="让文件更轻，让操作更简单。" Foreground="#84909E" FontSize="11" Margin="0,3,0,0"/></StackPanel>
   <Border Grid.Column="2" VerticalAlignment="Center" Background="#E8F2ED" CornerRadius="14" Padding="12,6"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#257A68" Margin="0,0,7,0"/><TextBlock x:Name="EngineLabel" Text="内嵌 UPX 5.2.1" FontSize="11" Foreground="#257A68"/></StackPanel></Border>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="284"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#EDF5F2" BorderBrush="#B7D6CB" BorderThickness="1" CornerRadius="12"><Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="拖放文件，即刻压缩" FontSize="21" FontWeight="SemiBold" Foreground="#224D42"/><TextBlock Text="EXE / DLL · 支持多文件与文件夹" Foreground="#708E84" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="本地处理，你的文件始终留在设备上。" Foreground="#8CA298" FontSize="11" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" x:Name="AddButton" Content="＋  添加文件" Background="White" BorderBrush="#C7DED5" Foreground="#257A68" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></Border>
    <Border Grid.Row="2" Background="White" BorderBrush="#E5E9EE" BorderThickness="1" CornerRadius="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="17,13"><StackPanel Orientation="Horizontal"><TextBlock Text="文件队列" FontWeight="SemiBold"/><Border Background="#F0F3F6" CornerRadius="5" Padding="7,1" Margin="9,0,0,0"><TextBlock Text="{Binding Items.Count, ElementName=Files}" FontSize="11" Foreground="#7B8695"/></Border></StackPanel><Button x:Name="ClearButton" Content="清理已完成" Style="{StaticResource QuietButton}" HorizontalAlignment="Right"/></Grid>
     <ListView x:Name="Files" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="文件名称" DisplayMemberBinding="{Binding Name}" Width="230"/><GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="85"/><GridViewColumn Header="原大小" DisplayMemberBinding="{Binding Before}" Width="90"/><GridViewColumn Header="压缩后" DisplayMemberBinding="{Binding After}" Width="90"/><GridViewColumn Header="变化" DisplayMemberBinding="{Binding Saving}" Width="75"/></GridView></ListView.View></ListView>
     <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=Files}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="↧" FontSize="34" Foreground="#CCD5DD" HorizontalAlignment="Center"/><TextBlock Text="文件队列还是空的" Foreground="#8793A1" Margin="0,10,0,0" HorizontalAlignment="Center"/><TextBlock Text="拖入文件，或点击上方“添加文件”" FontSize="11" Foreground="#A3ADB8" Margin="0,7,0,20"/></StackPanel>
    </Grid></Border>
    <Expander Grid.Row="3" Header="处理日志" IsExpanded="True" Foreground="#7B8695" FontSize="11" Margin="0,12,0,0"><TextBox x:Name="Details" Height="58" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Foreground="#7B8695" Padding="5,8" Text="选择文件后，这里会显示完整路径和处理日志。"/></Expander>
    <Grid Grid.Row="4" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Summary" Text="准备就绪" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="先校验，再替换。可按需开启原文件备份。" FontSize="10" Foreground="#8B96A3" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="StopButton" Content="停止" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="StartButton" Content="开始处理  →" Background="#257A68" BorderBrush="#257A68" Foreground="White" Padding="23,10"/></StackPanel></Grid>
   </Grid>
   <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#E5E9EE" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,18">
    <TextBlock Text="处理设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,22"/>
    <TextBlock Text="操作方式" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="Mode" SelectedIndex="0"><ComboBoxItem Content="压缩文件"/><ComboBoxItem Content="解压还原"/></ComboBox>
    <TextBlock Text="压缩强度" Foreground="#7B8695" FontSize="11" Margin="0,16,0,0"/><ComboBox x:Name="Preset" SelectedIndex="0"><ComboBoxItem Content="均衡压缩  ·  -7"/><ComboBoxItem Content="快速压缩  ·  -1"/><ComboBoxItem Content="最大压缩  ·  --best"/></ComboBox>
    <CheckBox x:Name="AutoStart" Content="添加文件后自动开始" IsChecked="True" Margin="0,14,0,0"/>
    <Border Height="1" Background="#EEF1F4" Margin="0,20,0,20"/>
    <StackPanel x:Name="AdvancedOptions"><TextBlock Text="压缩选项" Style="{StaticResource SectionLabel}"/><CheckBox x:Name="Backup" Content="创建原文件备份" IsChecked="False" ToolTip="在原文件旁保存独立命名的 .bak，不覆盖已有备份。"/><CheckBox x:Name="AllMethods" Content="尝试全部方法" ToolTip="--all-methods；耗时较长。"/><CheckBox x:Name="CompressExports" Content="压缩导出区段" IsChecked="True"/><CheckBox x:Name="StripRelocs" Content="移除重定位数据" IsChecked="False" ToolTip="仅适用于未启用 ASLR 的兼容 EXE；DLL、EFI 和启用 ASLR 的文件不能直接移除。默认保留。"/><CheckBox x:Name="Force" Content="强制压缩可疑文件" ToolTip="可能影响程序运行，建议保留备份。签名文件仍会跳过。"/>
     <TextBlock Text="附加数据" Foreground="#7B8695" FontSize="11" Margin="0,17,0,0"/><ComboBox x:Name="Overlay" SelectedIndex="0"><ComboBoxItem Content="保留附加数据"/><ComboBoxItem Content="丢弃附加数据（不可还原）"/><ComboBoxItem Content="跳过含附加数据的文件"/></ComboBox>
     <TextBlock Text="图标处理" Foreground="#7B8695" FontSize="11" Margin="0,16,0,0"/><ComboBox x:Name="Icons" SelectedIndex="2"><ComboBoxItem Content="不压缩图标"/><ComboBoxItem Content="保留第一个图标"/><ComboBoxItem Content="保留第一个图标目录"/><ComboBoxItem Content="压缩全部图标"/></ComboBox>
     <TextBlock Text="保持官方 UPX 标志，支持校验与解压。" Foreground="#99A3AF" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
    </StackPanel>
    <Border Height="1" Background="#EEF1F4" Margin="0,20,0,14"/><TextBlock Text="引擎管理" Style="{StaticResource SectionLabel}"/><WrapPanel><Button x:Name="DownloadButton" Content="恢复内嵌引擎" Style="{StaticResource QuietButton}"/><Button x:Name="EngineButton" Content="选择其他 UPX" Style="{StaticResource QuietButton}"/></WrapPanel>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,19,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="ProjectButton" Content="GitHub  ↗  Jay1023CN/upx-drop" Style="{StaticResource QuietButton}"/><TextBlock Text="·" Foreground="#B5BEC8" Margin="7,0" VerticalAlignment="Center"/><Button x:Name="LicenseButton" Content="关于与许可" Style="{StaticResource QuietButton}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="AutoUpdate" Content="自动更新" IsChecked="True" FontSize="11" Margin="0,0,12,0"/><Button x:Name="UpdateButton" Content="检查更新" Style="{StaticResource QuietButton}"/></StackPanel><TextBlock x:Name="UpdateStatus" Grid.Row="1" Grid.ColumnSpan="2" Text="从 GitHub Releases 检查更新；下载并校验后，退出时安装并重启。" Foreground="#98A2AF" FontSize="10" Margin="6,5,0,0" TextWrapping="Wrap"/></Grid>
 </Grid>
</Window>
