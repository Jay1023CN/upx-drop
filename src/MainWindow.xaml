<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UPX Drop" Width="1120" Height="820" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#101317" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" Foreground="#E1E7EF" AllowDrop="True" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#242B34"/><Setter Property="Foreground" Value="#D9E1EB"/><Setter Property="BorderBrush" Value="#343F4D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#70D4B6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,4"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#98A5B6"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E1E7EF"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#34463F"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#83DEC2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#DBE3EC"/><Setter Property="Background" Value="#20262F"/><Setter Property="BorderBrush" Value="#35404E"/><Setter Property="MinHeight" Value="35"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Box" CornerRadius="5" Background="#20262F" BorderBrush="#35404E" BorderThickness="1"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#8E9CAE" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#60746C"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#70D4B6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#252D37" BorderBrush="#425042" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#70D4B6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5,0,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="14" Height="14" CornerRadius="3" Background="#20262F" BorderBrush="#4B586A" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 2 6 L 5 9 L 10 3" Stroke="#0C241D" StrokeThickness="1.5" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#77D9B8"/><Setter TargetName="Box" Property="BorderBrush" Value="#77D9B8"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#46515F" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="8"/><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Foreground" Value="#8593A5"/><Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="#1D232B" BorderBrush="#2B3440" BorderThickness="0,1,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="#CBD6E2"/><Setter Property="Padding" Value="8,11"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" Background="Transparent" BorderBrush="#252D37" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#222D34"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#263E36"/><Setter Property="Foreground" Value="#99E4CC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#8F9BAA"/><Setter Property="FontSize" Value="11"/></Style>
 </Window.Resources>
 <Grid Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="9" Background="#77D9B8"><Path Data="M 8 7 L 8 16 M 3 12 L 8 17 L 13 12 M 3 21 L 13 21" Stroke="#143B30" StrokeThickness="2" Width="16" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="UPX Drop" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="VersionLabel" Text="v1.1.1" Foreground="#657387" FontSize="11" Margin="10,7,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="#77D9B8" Margin="0,0,8,0"/><TextBlock x:Name="EngineLabel" Text="UPX 5.2.1 · 就绪" Foreground="#8EA69C" FontSize="11"/></StackPanel></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#17241F" BorderBrush="#35574A" BorderThickness="1" CornerRadius="8"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="把文件拖到这里" Foreground="#D8F3E9" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="EXE / DLL / 文件夹，全部在本地处理" Foreground="#8AA69A" Margin="0,9,0,0"/></StackPanel><Button Grid.Column="1" x:Name="AddButton" Content="＋  添加文件" Background="#263F33" BorderBrush="#4D705F" Foreground="#B1E6CF" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid></Border>
    <Border Grid.Row="2" Background="#191E25" BorderBrush="#2A323D" BorderThickness="1" CornerRadius="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="14,12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="文件队列" FontWeight="SemiBold"/><TextBlock Text="{Binding Items.Count, ElementName=Files}" Foreground="#6D7F92" Margin="8,0,0,0"/><ProgressBar x:Name="QueueProgress" Minimum="0" Maximum="1" Value="0" Width="66" Height="3" Foreground="#77D9B8" Background="#2E3945" BorderThickness="0" Margin="16,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="QueueProgressText" Text="0/0" Foreground="#77899C" FontSize="10" VerticalAlignment="Center"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="RetryButton" Content="重试失败项" IsEnabled="False" Style="{StaticResource QuietButton}"/><Button x:Name="ClearButton" Content="清理已完成" Style="{StaticResource QuietButton}"/></StackPanel></Grid>
     <ListView x:Name="Files" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="文件名称" DisplayMemberBinding="{Binding Name}" Width="225"/><GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="80"/><GridViewColumn Header="原大小" DisplayMemberBinding="{Binding Before}" Width="82"/><GridViewColumn Header="结果大小" DisplayMemberBinding="{Binding After}" Width="82"/><GridViewColumn Header="变化" DisplayMemberBinding="{Binding Saving}" Width="65"/></GridView></ListView.View></ListView>
     <StackPanel Grid.Row="1" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=Files}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Path Data="M 0 0 L 18 0 L 26 8 L 26 32 L 0 32 Z M 18 0 L 18 8 L 26 8 M 7 16 L 19 16 M 7 22 L 15 22" Stroke="#465767" StrokeThickness="1.5" HorizontalAlignment="Center"/><TextBlock Text="等待添加文件" Foreground="#9AA8B9" FontSize="14" Margin="0,18,0,0" HorizontalAlignment="Center"/><TextBlock Text="支持批量拖入，也可以选择整个文件夹" Foreground="#5E7085" FontSize="11" Margin="0,8,0,20"/></StackPanel>
    </Grid></Border>
    <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="处理日志" Foreground="#6F8195" FontSize="10" Margin="1,0,0,7"/><TextBox x:Name="Details" Height="52" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#13181E" Foreground="#8293A6" BorderBrush="#29323D" BorderThickness="1" Padding="10,8" FontSize="11" Text="选择文件查看完整路径和处理日志。"/></StackPanel>
    <Grid Grid.Row="4" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Summary" Text="准备就绪" Foreground="#BAC7D5" FontSize="12"/><TextBlock Text="默认覆盖原文件，可在右侧开启备份" Foreground="#596D82" FontSize="10" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="StopButton" Content="停止" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="StartButton" Content="开始压缩  →" Background="#77D9B8" BorderBrush="#77D9B8" Foreground="#12382C" FontWeight="SemiBold" Padding="22,10"/></StackPanel></Grid>
   </Grid>
   <Border Grid.Column="2" Background="#191E25" BorderBrush="#2A323D" BorderThickness="1" CornerRadius="8"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="18,16"><TextBlock x:Name="SettingsTitle" Text="压缩设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,17"/>
    <TextBlock Text="操作方式" Style="{StaticResource Label}"/><ComboBox x:Name="Mode" SelectedIndex="0"><ComboBoxItem Content="压缩文件"/><ComboBoxItem Content="解压还原"/></ComboBox>
    <TextBlock Text="压缩强度" Style="{StaticResource Label}" Margin="0,13,0,0"/><ComboBox x:Name="Preset" SelectedIndex="0"><ComboBoxItem Content="均衡   -7"/><ComboBoxItem Content="快速   -1"/><ComboBoxItem Content="最大压缩   --best"/></ComboBox>
    <CheckBox x:Name="AutoStart" Content="添加后自动开始" IsChecked="True" Margin="0,13,0,0"/>
    <Border Height="1" Background="#2A323D" Margin="0,15,0,13"/>
    <StackPanel x:Name="AdvancedOptions"><TextBlock Text="文件选项" Style="{StaticResource Label}" Margin="0,0,0,6"/><CheckBox x:Name="Backup" Content="创建原文件备份" IsChecked="False" ToolTip="保存独立命名的 .bak 备份，不覆盖历史备份。"/><CheckBox x:Name="AllMethods" Content="尝试全部方法（较慢）"/><CheckBox x:Name="CompressExports" Content="压缩导出区段" IsChecked="True"/><CheckBox x:Name="StripRelocs" Content="移除重定位数据" IsChecked="False" ToolTip="仅适用于不使用 ASLR 的兼容 EXE；默认保留。"/><CheckBox x:Name="Force" Content="强制压缩可疑文件" ToolTip="可能影响程序运行，建议保留备份。"/>
     <TextBlock Text="附加数据" Style="{StaticResource Label}" Margin="0,11,0,0"/><ComboBox x:Name="Overlay" SelectedIndex="0"><ComboBoxItem Content="保留附加数据"/><ComboBoxItem Content="丢弃附加数据（不可还原）"/><ComboBoxItem Content="跳过含附加数据的文件"/></ComboBox>
     <TextBlock Text="图标处理" Style="{StaticResource Label}" Margin="0,13,0,0"/><ComboBox x:Name="Icons" SelectedIndex="2"><ComboBoxItem Content="不压缩图标"/><ComboBoxItem Content="保留第一个图标"/><ComboBoxItem Content="保留第一个图标目录"/><ComboBoxItem Content="压缩全部图标"/></ComboBox>
    </StackPanel>
    <Border Height="1" Background="#2A323D" Margin="0,16,0,10"/><WrapPanel><Button x:Name="DownloadButton" Content="恢复内嵌引擎" Style="{StaticResource QuietButton}"/><Button x:Name="EngineButton" Content="切换引擎" Style="{StaticResource QuietButton}"/></WrapPanel>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="ProjectButton" Content="GitHub ↗" Style="{StaticResource QuietButton}"/><TextBlock Text="/" Foreground="#3F4D5D" Margin="6,0" VerticalAlignment="Center"/><Button x:Name="LicenseButton" Content="关于与许可" Style="{StaticResource QuietButton}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="AutoUpdate" Content="自动更新" IsChecked="True" FontSize="11" Margin="0,0,12,0"/><Button x:Name="UpdateButton" Content="检查更新" Style="{StaticResource QuietButton}"/></StackPanel><TextBlock x:Name="UpdateStatus" Grid.Row="1" Grid.ColumnSpan="2" Text="从 GitHub 检查新版本" Foreground="#586B80" FontSize="10" Margin="7,5,0,0" TextWrapping="Wrap"/></Grid>
 </Grid>
</Window>
