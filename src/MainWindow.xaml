<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UPX Drop" Width="1180" Height="820" MinWidth="1060" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#F8FAFC" FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#0F172A" AllowDrop="True" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#1E293B"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,8"/><Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F8FAFC"/><Setter TargetName="Surface" Property="BorderBrush" Value="#CBD5E1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F1F5F9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Surface" Property="BorderThickness" Value="1.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#64748B"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#0F172A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E2E8F0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="#0F172A"/><Setter Property="Padding" Value="10,7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="SelectionBrush" Value="#BFDBFE"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#F1F5F9"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#1E293B"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#64748B" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#CBD5E1"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#2563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,6,30,6" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#2563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Cursor="Hand"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="0,5"><Grid><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" Margin="0,0,24,0"/><Path x:Name="Chevron" Data="M 0 0 L 4 4 L 8 0" Stroke="#64748B" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter><Setter TargetName="Chevron" Property="Stroke" Value="#2563EB"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#2563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="Body" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Segment" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#64748B"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Key" Background="Transparent" Padding="4,8" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Key" Property="Background" Value="#FFFFFF"/><Setter TargetName="Key" Property="BorderBrush" Value="#E2E8F0"/><Setter TargetName="Key" Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#0F172A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Key" Property="BorderBrush" Value="#2563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Margin" Value="0,7"/><Setter Property="Foreground" Value="#334155"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="17" Height="17" CornerRadius="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 3.5 8.5 L 6.5 11.5 L 13 4.5" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#2563EB"/><Setter TargetName="Box" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#2563EB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListViewItem">
   <Setter Property="Padding" Value="6,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#F1F5F9"/><Setter Property="ToolTip" Value="{Binding Path}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><GridViewRowPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#DBEAFE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="GridViewColumnHeader">
   <Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,9"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E2E8F0"/>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#475569"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Badge" TargetType="Border">
   <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="8,3"/><Setter Property="Background" Value="#F1F5F9"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Status}" Value="处理中"><Setter Property="Background" Value="#DBEAFE"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="已压缩"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="已解压"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="失败"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="已取消"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="StatusText" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#64748B"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Status}" Value="处理中"><Setter Property="Foreground" Value="#1D4ED8"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="已压缩"><Setter Property="Foreground" Value="#15803D"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="已解压"><Setter Property="Foreground" Value="#15803D"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="失败"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="已取消"><Setter Property="Foreground" Value="#B45309"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid x:Name="Workspace" Margin="24,18,24,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- Header -->
  <Grid Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image x:Name="BrandIcon" Width="38" Height="38" Stretch="Uniform"/>
    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="UPX Drop" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
      <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
       <TextBlock x:Name="AppVersion" Text="v1.2.1" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
      </Border>
     </StackPanel>
     <TextBlock Text="可执行文件极速压缩器 · 本地原子处理" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
    </StackPanel>
   </StackPanel>
   <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse Width="8" Height="8" x:Name="RunIndicator" Fill="#10B981" Margin="0,0,8,0"/>
     <TextBlock x:Name="EngineLabel" Text="UPX 5.2.1 · 已就绪" FontSize="12" FontWeight="Medium" Foreground="#334155"/>
    </StackPanel>
   </Border>
  </Grid>
  <!-- Main Body -->
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
   <!-- Left Column: Operations & Queue -->
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- Drop Surface -->
    <Border x:Name="DropSurface" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10">
     <Grid Margin="20,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="46" Height="46" CornerRadius="23" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
       <Path Data="M 12 6 L 12 16 M 8 12 L 12 16 L 16 12 M 6 20 L 18 20" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock x:Name="DropTitle" Text="投放文件" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
       <TextBlock Text="拖入 EXE、DLL 文件或文件夹 · 自动识别与就绪" Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
       <Button x:Name="AddButton" Content="添加文件" Foreground="White" Background="#2563EB" BorderThickness="0" FontWeight="SemiBold" Padding="18,8" ToolTip="Ctrl+O">
        <Button.Template>
         <ControlTemplate TargetType="Button">
          <Border x:Name="BtnSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
           <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BtnSurface" Property="Background" Value="#1D4ED8"/></Trigger>
           <Trigger Property="IsPressed" Value="True"><Setter TargetName="BtnSurface" Property="Background" Value="#1E40AF"/></Trigger>
           <Trigger Property="IsEnabled" Value="False"><Setter TargetName="BtnSurface" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </Button.Template>
       </Button>
       <Button x:Name="FolderButton" Content="选择文件夹" Foreground="#475569" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Medium" Padding="14,6" Margin="0,4,0,0">
        <Button.Template>
         <ControlTemplate TargetType="Button">
          <Border x:Name="FolderSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
           <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FolderSurface" Property="Background" Value="#F8FAFC"/><Setter TargetName="FolderSurface" Property="BorderBrush" Value="#94A3B8"/><Setter Property="Foreground" Value="#0F172A"/></Trigger>
           <Trigger Property="IsPressed" Value="True"><Setter TargetName="FolderSurface" Property="Background" Value="#F1F5F9"/></Trigger>
           <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </Button.Template>
       </Button>
      </StackPanel>
     </Grid>
    </Border>
    <!-- Stats Summary Chips -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
     <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,5">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="总计" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
       <TextBlock x:Name="TotalSize" Text="0 B" FontWeight="Bold" Foreground="#0F172A" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="10,0,0,0">
      <StackPanel Orientation="Horizontal">
       <TextBlock x:Name="SavedLabel" Text="净节省" Foreground="#047857" FontSize="11" VerticalAlignment="Center"/>
       <TextBlock x:Name="SavedSize" Text="0 B" FontWeight="Bold" Foreground="#059669" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="10,0,0,0">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="已完成" Foreground="#1D4ED8" FontSize="11" VerticalAlignment="Center"/>
       <TextBlock x:Name="DoneCount" Text="0" FontWeight="Bold" Foreground="#2563EB" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <!-- File Queue Card -->
    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- Queue Header -->
      <Grid Margin="16,12,14,10">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="文件队列" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
        <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
         <TextBlock x:Name="QueueCount" Text="0" Foreground="#475569" FontWeight="SemiBold" FontSize="11"/>
        </Border>
       </StackPanel>
       <Button x:Name="ExportButton" Content="导出 CSV" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" ToolTip="导出整个队列，包括筛选隐藏的文件"/>
      </Grid>
      <!-- Search & Filter Bar -->
      <Grid Grid.Row="1" Margin="14,0,14,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="136"/></Grid.ColumnDefinitions>
       <Grid>
        <TextBox x:Name="SearchBox" ToolTip="搜索文件名或路径 · Ctrl+F"/>
        <TextBlock Text="搜索文件名或路径 · Ctrl+F" Foreground="#94A3B8" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </Grid>
       <ComboBox x:Name="StatusFilter" Grid.Column="2" SelectedIndex="0">
        <ComboBoxItem Content="全部状态"/>
        <ComboBoxItem Content="等待 / 处理中"/>
        <ComboBoxItem Content="已完成"/>
        <ComboBoxItem Content="失败 / 已取消"/>
       </ComboBox>
      </Grid>
      <!-- ListView -->
      <ListView Foreground="#0F172A" x:Name="Files" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListView.View>
        <GridView>
         <GridViewColumn Header="文件" Width="280">
          <GridViewColumn.CellTemplate>
           <DataTemplate>
            <StackPanel Margin="2,0">
             <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
           </DataTemplate>
          </GridViewColumn.CellTemplate>
         </GridViewColumn>
         <GridViewColumn Header="状态" Width="92">
          <GridViewColumn.CellTemplate>
           <DataTemplate>
            <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
             <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
            </Border>
           </DataTemplate>
          </GridViewColumn.CellTemplate>
         </GridViewColumn>
         <GridViewColumn Header="原大小" DisplayMemberBinding="{Binding Before}" Width="88"/>
         <GridViewColumn Header="处理后" DisplayMemberBinding="{Binding After}" Width="88"/>
         <GridViewColumn Header="变化" Width="80">
          <GridViewColumn.CellTemplate>
           <DataTemplate>
            <TextBlock Text="{Binding Saving}" Foreground="#10B981" FontWeight="Bold"/>
           </DataTemplate>
          </GridViewColumn.CellTemplate>
         </GridViewColumn>
        </GridView>
       </ListView.View>
      </ListView>
      <!-- Empty State -->
      <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
       <StackPanel.Style>
        <Style TargetType="StackPanel">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=Files}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
       </StackPanel.Style>
       <Border Width="52" Height="52" CornerRadius="26" Background="#F1F5F9" HorizontalAlignment="Center">
        <Path Data="M 14 9 L 26 9 L 34 17 L 34 39 L 14 39 Z M 26 9 L 26 17 L 34 17 M 20 27 L 28 27 M 24 23 L 24 31" Stroke="#94A3B8" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <TextBlock x:Name="EmptyTitle" Text="还没有文件" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
       <TextBlock x:Name="EmptyHint" Text="拖入 EXE、DLL 文件或文件夹即可开始" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
      <!-- Queue Footer Toolbar -->
      <Border Grid.Row="3" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="12,8">
       <Grid>
        <StackPanel Orientation="Horizontal">
         <Button x:Name="RetryButton" Content="重试未完成" Style="{StaticResource QuietButton}"/>
         <Button x:Name="RemoveButton" Content="移除选中" Style="{StaticResource QuietButton}" ToolTip="仅移出队列，不删除文件 · Delete"/>
         <Button x:Name="ClearButton" Content="清理已完成" Style="{StaticResource QuietButton}"/>
        </StackPanel>
        <TextBlock x:Name="VisibleCount" Text="显示 0 / 0" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
       </Grid>
      </Border>
     </Grid>
    </Border>
    <!-- Log & Details Expander -->
    <Expander x:Name="DetailsExpander" Grid.Row="3" Header="文件详情与运行日志" Foreground="#475569" FontSize="11.5" Margin="0,10,0,0">
     <Grid Margin="0,6,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Button x:Name="RevealButton" Content="在文件夹中显示 ↗" HorizontalAlignment="Right" Style="{StaticResource QuietButton}"/>
      <TextBox x:Name="Details" Grid.Row="1" Height="72" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="1" BorderBrush="#E2E8F0" Background="#F8FAFC" Foreground="#334155" FontFamily="Consolas, Cascadia Code, Segoe UI" Text="选择文件，查看完整路径和处理日志。"/>
     </Grid>
    </Expander>
    <!-- Action Bar & Progress -->
    <Grid Grid.Row="4" Margin="0,12,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
      <TextBlock x:Name="Summary" Text="准备就绪" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <TextBlock x:Name="ProgressText" Text="等待添加文件" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="StopButton" Content="停止" IsEnabled="False" Margin="0,0,8,0" Padding="16,9" Background="#F1F5F9" BorderBrush="#E2E8F0"/>
      <Button x:Name="StartButton" Content="开始压缩" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" Padding="24,9" MinHeight="36">
       <Button.Template>
        <ControlTemplate TargetType="Button">
         <Border x:Name="StartSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StartSurface" Property="Background" Value="#1D4ED8"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="StartSurface" Property="Background" Value="#1E40AF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="StartSurface" Property="Opacity" Value="0.45"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Button.Template>
      </Button>
     </StackPanel>
     <ProgressBar x:Name="QueueProgress" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="0" Height="4" Margin="0,10,0,0" BorderThickness="0" Background="#E2E8F0" Foreground="#2563EB"/>
    </Grid>
   </Grid>
   <!-- Right Column: Control Panel Card -->
   <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="18,14,18,16">
      <TextBlock Text="控制面板" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>
      <!-- Processing Mode -->
      <TextBlock Text="处理方式" Style="{StaticResource Label}"/>
      <Border Background="#F1F5F9" CornerRadius="7" Padding="3" Margin="0,0,0,0">
       <UniformGrid x:Name="ModeSelector" Columns="2">
        <RadioButton x:Name="PackMode" GroupName="Operation" Content="压缩" Style="{StaticResource Segment}"/>
        <RadioButton x:Name="UnpackMode" GroupName="Operation" Content="解压" Style="{StaticResource Segment}"/>
       </UniformGrid>
      </Border>
      <ComboBox x:Name="Mode" Visibility="Collapsed" SelectedIndex="0"><ComboBoxItem Content="压缩文件"/><ComboBoxItem Content="解压还原"/></ComboBox>
      <!-- Compression Level -->
      <TextBlock Text="压缩强度" Style="{StaticResource Label}" Margin="0,16,0,8"/>
      <Border Background="#F1F5F9" CornerRadius="7" Padding="3">
       <UniformGrid x:Name="PresetSelector" Columns="3">
        <RadioButton x:Name="FastPreset" GroupName="Level" Content="快速" Style="{StaticResource Segment}"/>
        <RadioButton x:Name="BalancedPreset" GroupName="Level" Content="均衡" Style="{StaticResource Segment}"/>
        <RadioButton x:Name="BestPreset" GroupName="Level" Content="极致" Style="{StaticResource Segment}"/>
       </UniformGrid>
      </Border>
      <ComboBox x:Name="Preset" Visibility="Collapsed" SelectedIndex="0"><ComboBoxItem Content="均衡 · 推荐"/><ComboBoxItem Content="快速 · 优先速度"/><ComboBoxItem Content="极致 · 优先体积"/></ComboBox>
      <TextBlock x:Name="ModeHint" Text="压缩后校验通过，再替换原文件。" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,14"/>
      <CheckBox x:Name="AutoStart" Content="添加后自动开始" IsChecked="True"/>
      <StackPanel x:Name="AdvancedOptions">
       <CheckBox x:Name="Backup" Content="保留原文件备份" IsChecked="False" ToolTip="在原文件旁保存独立命名的 .bak，不覆盖已有备份。"/>
       <Border Height="1" Background="#F1F5F9" Margin="0,14"/>
       <Expander x:Name="AdvancedExpander" Header="高级压缩选项">
        <StackPanel x:Name="CompressionOptions" Margin="0,10,0,0">
         <CheckBox x:Name="AllMethods" Content="尝试全部方法" ToolTip="--all-methods；耗时较长。"/>
         <CheckBox x:Name="CompressExports" Content="压缩导出区段" IsChecked="True"/>
         <CheckBox x:Name="StripRelocs" Content="移除重定位数据" ToolTip="仅适用于未启用 ASLR 的兼容 EXE，默认保留。"/>
         <CheckBox x:Name="Force" Content="强制压缩可疑文件" ToolTip="可能影响程序运行；签名文件仍会跳过。"/>
         <TextBlock Text="附加数据" Style="{StaticResource Label}" Margin="0,12,0,6"/>
         <ComboBox x:Name="Overlay" SelectedIndex="0"><ComboBoxItem Content="保留附加数据"/><ComboBoxItem Content="丢弃（不可还原）"/><ComboBoxItem Content="含附加数据时跳过"/></ComboBox>
         <TextBlock Text="图标处理" Style="{StaticResource Label}" Margin="0,12,0,6"/>
         <ComboBox x:Name="Icons" SelectedIndex="2"><ComboBoxItem Content="不压缩图标"/><ComboBoxItem Content="保留第一个图标"/><ComboBoxItem Content="保留第一个图标目录"/><ComboBoxItem Content="压缩全部图标"/></ComboBox>
        </StackPanel>
       </Expander>
      </StackPanel>
      <Border Height="1" Background="#F1F5F9" Margin="0,16"/>
      <!-- Volume Telemetry -->
      <StackPanel Margin="0,0,0,16">
       <TextBlock Text="体积对比" Style="{StaticResource Label}"/>
       <Grid Margin="0,1,0,6">
        <TextBlock Text="输入" FontSize="11" Foreground="#64748B"/>
        <TextBlock x:Name="MeterBefore" Text="0 B" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A"/>
       </Grid>
       <UniformGrid x:Name="InputMeter" Columns="24" Height="12"/>
       <Grid Margin="0,8,0,6">
        <TextBlock Text="输出" FontSize="11" Foreground="#64748B"/>
        <TextBlock x:Name="MeterAfter" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="11" Foreground="#10B981"/>
       </Grid>
       <UniformGrid x:Name="OutputMeter" Columns="24" Height="12"/>
       <TextBlock Text="随已完成文件实时更新" Foreground="#94A3B8" FontSize="10" Margin="0,6,0,0"/>
      </StackPanel>
      <!-- Engine Management -->
      <Expander Header="引擎管理">
       <StackPanel Margin="0,8,0,0">
        <TextBlock Text="官方 UPX 5.2.1" FontWeight="SemiBold" Foreground="#0F172A"/>
        <TextBlock Text="文件在本机处理，无网络上传" Foreground="#64748B" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap"/>
        <Button x:Name="DownloadButton" Content="恢复内嵌引擎" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
        <Button x:Name="EngineButton" Content="选择其他 UPX" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <!-- Footer -->
  <Grid Grid.Row="2" Margin="0,12,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="ProjectButton" Content="GitHub ↗" Style="{StaticResource QuietButton}"/>
    <Button x:Name="LicenseButton" Content="关于与许可" Style="{StaticResource QuietButton}" Margin="4,0,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <CheckBox x:Name="AutoUpdate" Content="自动更新" IsChecked="True" FontSize="11.5" Margin="0,0,8,0"/>
    <Button x:Name="UpdateButton" Content="检查更新" Style="{StaticResource QuietButton}"/>
   </StackPanel>
   <TextBlock x:Name="UpdateStatus" Grid.Row="1" Grid.ColumnSpan="2" Text="更新校验完成后，将在退出时安装。" Foreground="#94A3B8" FontSize="10.5" Margin="6,2,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>