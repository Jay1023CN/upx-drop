<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UPX Drop" Width="1180" Height="820" MinWidth="1060" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#DCE1DF" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#24322F" AllowDrop="True" UseLayoutRounding="True">
